{
  "manifest_version": 3,
  "name": "Labs ASP Browser Bridge",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Lets the Labs ASP agent fill forms in one approved tab.",
  "key": "",
  "permissions": ["debugger", "tabs", "storage", "sidePanel", "alarms"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Labs ASP"
  }
}
