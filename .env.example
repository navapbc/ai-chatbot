# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# Google OAuth (for Google sign-in)
GOOGLE_CLIENT_ID=****
GOOGLE_CLIENT_SECRET=****

# xAI API Key for chat and image models: https://console.x.ai/
XAI_API_KEY=****

# PostgreSQL database - used by both client and Mastra
# Client: Chat history, votes, documents, user data
# Mastra: Agent memory, workflows, traces, participants data
# For local development with Docker postgres container:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/labs_asp_dev"
# For Docker-to-Docker communication (used inside containers):
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/labs_asp_dev"

# OpenAI API Key (primary AI provider)
OPENAI_API_KEY=****

# Alternative API keys (optional)
ANTHROPIC_API_KEY=****
GOOGLE_GENERATIVE_AI_API_KEY=****
EXA_API_KEY=****

# Google Cloud Configuration
# Use `global` to match production (terraform/cloud_run.tf hardcodes it). The
# opus base models have NO quota in any regional endpoint (us-east5 &c. return
# 429 RESOURCE_EXHAUSTED); only `global` serves them. sonnet-4-6 and haiku-4-5
# work either way. See agent/README.md "Vertex region".
GOOGLE_VERTEX_LOCATION=global
GOOGLE_VERTEX_PROJECT=****
GOOGLE_APPLICATION_CREDENTIALS=./vertex-ai-credentials.json
GOOGLE_CLOUD_PROJECT=****

# Google Cloud Storage for file uploads
GCS_BUCKET_NAME=****

# Mastra Backend API for web automation
# MASTRA_SERVER_URL is used by the client to connect to the Mastra backend
# For local development: http://localhost:4111
# For Docker deployment: http://localhost:4111 (external port mapping)
MASTRA_API_URL=****
MASTRA_JWT_TOKEN=****
MASTRA_SERVER_URL=http://localhost:4111

# NEXT_PUBLIC_MASTRA_SERVER_URL is required for client-side requests to Mastra
# This MUST be set at build time for Next.js to embed it in the client bundle
# For local development: http://localhost:4111
# For Docker deployment: http://localhost:4111 (external port mapping)
NEXT_PUBLIC_MASTRA_SERVER_URL=http://localhost:4111

# Upstash Redis for shared links
# Create a Redis database at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=****
UPSTASH_REDIS_REST_TOKEN=****

# Microsoft login
AUTH_MICROSOFT_ENTRA_ID_ID=***
AUTH_MICROSOFT_ENTRA_ID_SECRET=***
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# Cloudflare Verified Bots - Ed25519 private key in PEM format
# Used to sign the /.well-known/http-message-signatures-directory response
CLOUDFLARE_BOT_PRIVATE_KEY=****

# Environment name (dev, prod, preview-*, etc.)
# Used for client-side environment checks (e.g. hiding suggested actions in prod)
ENVIRONMENT=dev
NEXT_PUBLIC_ENVIRONMENT=dev

# Feature flag for AI SDK agent vs Mastra
USE_AI_SDK_AGENT=false
NEXT_PUBLIC_USE_AI_SDK_AGENT=false
# Kernel.sh API key for remote browser management (used when USE_AI_SDK_AGENT=true)
KERNEL_API_KEY=****

# TypeSafe (Jev) API key. Required for any JEV_FEATURES entry below and for
# the Jev online eval scorer. Get one at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=****

# Which Jev features run in the agent loop. Comma-separated, or "all".
# Empty/unset (the default) means no Jev call is made anywhere in the app.
#   gap-triage     annotate gap-analysis rows with whether the record answers them
#   summary-check  check each filled value, and its source label, against the record
#   field-value    enable the resolveFieldValue tool
# A server-side env var rather than lib/feature-flags.ts: that resolves
# overrides from localStorage and returns null when there is no window, so on
# the server only its defaultValue would ever apply. All three run server-side.
# Every feature no-ops when TYPESAFE_API_KEY is unset.
JEV_FEATURES=

# Print every OpenTelemetry span to stdout as it ends (ConsoleSpanExporter).
# Local debugging only: needs no API key and no network, which makes it the one
# way to see Jev and browser spans in an environment with no exporter. Noisy.
# The structured `jev.batch.finish` log lines print without this.
OTEL_CONSOLE_SPANS=

# Feature flag for guest login in preview environments
# When true, enables a guest login form that bypasses OAuth
# Only enabled for preview-pr-* deployments
USE_GUEST_LOGIN=false
NEXT_PUBLIC_USE_GUEST_LOGIN=false

# Allowed email domains for OAuth sign-in (comma-separated)
ALLOWED_EMAIL_DOMAINS=@example.com,@other.org

# Braintrust for tracing and evals
# Get an API key at https://www.braintrust.dev/app/settings/api-keys
# When set, the chat route exports AI spans via instrumentation.ts.
# Leave unset in environments where you don't want trace export.
BRAINTRUST_API_KEY=****
# Parent project for exported spans. Format: project_name:<name> or project_id:<uuid>
BRAINTRUST_PARENT=project_name:labs-asp

# Model used by the eval suite (evals/*.eval.ts). Recognised prefixes:
#   gpt-* / o1* / o3*  → OpenAI         (needs OPENAI_API_KEY)
#   claude-*           → Anthropic      (needs ANTHROPIC_API_KEY)
#   gemini-*           → Google         (needs GOOGLE_GENERATIVE_AI_API_KEY)
# CI runs a matrix over gpt-5.1 / claude-opus-4-7 / claude-opus-4-8 / gemini-3-pro.
# Defaults to gpt-5-mini when unset.
EVAL_MODEL=gpt-5-mini
# The Eve agent (agent/agent.ts) calls Vertex AI directly and needs no AI Gateway
# key — it reuses GOOGLE_APPLICATION_CREDENTIALS + GOOGLE_VERTEX_PROJECT/LOCATION
# above. Start the agent with `pnpm eve:dev`, which loads this file via
# dotenv-cli; bare `eve dev` does not, and the relative credentials path will
# not resolve. Set AI_GATEWAY_API_KEY only if you reintroduce a gateway model id
# string anywhere under agent/ (e.g. an Eve eval judge model).
AI_GATEWAY_API_KEY=

# Base URL of a SEPARATE Eve agent server, used by the /api/eve-chat adapter.
# Not needed for normal local dev: next.config.ts wraps the config in withEve(),
# so `pnpm dev` runs Eve as a child of `next dev` and serves it same-origin at
# /eve/v1/**. Only set this when pointing the adapter at an Eve server you are
# running yourself (e.g. `pnpm eve:dev`).
EVE_SERVER_URL=http://127.0.0.1:2000

# Eve durable-workflow state. Unset locally: Eve then uses its built-in file
# world under .eve/.workflow-data and needs no setup. Set it (deployments do,
# via terraform) to store durable sessions in Postgres instead — run
# `pnpm tsx scripts/bootstrap-workflow-db.ts` once against the same URL first.
# Must be a DIRECT connection, never a pooled endpoint (Neon `-pooler`,
# PgBouncer transaction mode): graphile-worker needs LISTEN/NOTIFY and the
# bootstrap takes a session-scoped advisory lock.
WORKFLOW_POSTGRES_URL=postgresql://user:pass@host:5432/db

# --- Browser extension (relay runs) ---------------------------------------
# Everything below is for running the Chrome extension against a local app, Eve
# agent and relay. It is all off unless you uncomment it. Setup steps and a
# symptom table are in docs/local-extension.md; the deployed rollout is in
# docs/rollout-pilot.md. `scripts/dev-relay.sh` checks that the names below
# that are required are set (it prints names, never values) and starts the relay.
#
# The extension is built separately and bakes in the app origin:
#   APP_ORIGIN=http://localhost:3000 pnpm extension:build
# then load extension/dist in chrome://extensions. (The e2e suites rebuild
# extension/dist in place without an app origin: rebuild it after a test run.)

# Turns relay runs on. Must be exactly 1: any other value leaves them off, and
# an eve-chat start that carries `relay` is then refused with a 400.
RELAY_RUNS_ENABLED=1

# Turns on the route that mints the extension's token (POST /api/relay/token).
# Must be exactly 1. Set it only together with RELAY_RUNS_ENABLED.
RELAY_TOKEN_ENDPOINT_ENABLED=1

# Signs and verifies relay tokens. The app and the relay both read this file, so
# they share it. At least 32 characters; shorter makes both token routes return
# 500 and stops the relay at start. Generate one: openssl rand -hex 32
RELAY_TOKEN_SECRET=your_generated_secret_here

# Shared by the app and Eve (Eve reads it when it STARTS: restart `pnpm eve:dev`
# after changing it, and make sure no older Eve is still running). At least 32
# characters; shorter counts as unset. Generate one: openssl rand -hex 32
EVE_INTERNAL_SECRET=your_generated_secret_here

# Where the app tells the extension and the agent to reach the relay. No path,
# query or credentials. http/ws is accepted for localhost only; use https/wss
# anywhere else. A start with this unset or invalid is refused with a 400 and
# logs "RELAY_PUBLIC_URL is unset or not a relay URL".
RELAY_PUBLIC_URL=http://localhost:8080

# Optional. When set, every relay and participant route refuses a request whose
# Origin is a different one and requires it on state-changing routes. Unset means
# no check. The value is chrome-extension:// plus the contents of
# extension/EXTENSION_ID.
RELAY_EXTENSION_ORIGIN=chrome-extension://ppcenadbeddfnlgklnccjkgjegmbkkkl

# Optional. Comma-separated model picker ids a relay run may request. Unset uses
# the default (claude-opus-5).
RELAY_ALLOWED_MODELS=

# Optional. Relay runs a single user may start per hour. Default 20.
RELAY_MAX_RUNS_PER_HOUR=20

# Optional. Where Eve reaches the app. Default http://127.0.0.1:3000.
APP_INTERNAL_URL=http://127.0.0.1:3000

# The relay process (relay/main.ts) also reads this file, plus:
#   PORT                     default 8080
#   RELAY_ALLOWED_HOSTS      comma-separated hostnames the relay answers to. It
#                            refuses any other Host with a 421. scripts/dev-relay.sh
#                            sets localhost,127.0.0.1 when it is not set.
#   RELAY_ALLOWED_HOST_SUFFIXES  same, as suffixes (the deployed relay uses .run.app)
#   RELAY_EXTENSION_ID       optional; the extension id (no chrome-extension://
#                            prefix) the relay requires in the Origin of /extension
# Sites on the Home screen come from config/relay-sites.json (empty by default;
# use "Use this tab" on an https form page). Participants come from the
# Participant table: apply migrations (`pnpm db:migrate`) and seed it
# (`pnpm exec dotenv -e .env.local -- tsx scripts/seed-participants.ts`).
